# 复制为 .env 仅供本地参考；Spring Boot 不会自动读取 .env，
# 请在 IDE 运行配置、Docker Compose 或 shell 中注入这些环境变量。

# 数据库
DB_URL=jdbc:mysql://localhost:3306/forum?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT：至少 32 字节的随机串，可用 `openssl rand -base64 48` 生成
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# 首次启动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_AUTO_INIT=true

# 可选
SERVER_PORT=8080
APP_UPLOAD_DIR=./picture
APP_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
LOG_LEVEL=INFO
